# Copy to .env and fill in. Never commit .env. Use synthetic data only.

# Odoo (read-only DB role for SQL, API key for actions)
ODOO_DB_HOST=localhost
ODOO_DB_NAME=odoo
ODOO_DB_RO_USER=
ODOO_DB_RO_PASSWORD=
ODOO_DB_PASSWORD=
ODOO_HOST_PORT=8069
ODOO_URL=http://localhost:8069
ODOO_API_KEY=
# API key for the separate synthetic full-stack Odoo instance only.
FULL_STACK_ODOO_API_KEY=
FULL_STACK_ODOO_DB_PASSWORD=
FULL_STACK_ODOO_RO_PASSWORD=
FULL_STACK_ENGINE_DB_PASSWORD=
FULL_STACK_ENGINE_DATABASE_URL=
FULL_STACK_ODOO_READONLY_DATABASE_URL=
FULL_STACK_INSTANCE_ID=
FULL_STACK_SCAN_PAGE_SIZE=50
FULL_STACK_SCAN_INTERVAL_SECONDS=60
FULL_STACK_MODEL_CACHE=
FULL_STACK_ODOO_PORT=18070
FULL_STACK_MAILPIT_PORT=18025
FULL_STACK_PROPOSAL_SYNTHETIC_ONLY=
FULL_STACK_PROPOSAL_BUDGET_USD=
FULL_STACK_PROPOSAL_INPUT_TOKEN_LIMIT=
FULL_STACK_PROPOSAL_OUTPUT_TOKEN_LIMIT=
FULL_STACK_PROPOSAL_REVIEW_ID=
FULL_STACK_PROPOSAL_REVIEW_BUDGET_USD=
# Proposal step (synthetic POC only; all limits must be set explicitly)
PROPOSAL_SYNTHETIC_ONLY=
PROPOSAL_BUDGET_USD=
PROPOSAL_INPUT_TOKEN_LIMIT=
PROPOSAL_OUTPUT_TOKEN_LIMIT=
# Read-only SQL role for the engine reader, e.g. postgresql://odoo_ro:<password>@127.0.0.1:5432/odoo
ODOO_READONLY_DATABASE_URL=
# Optional: extra allowed hosts for ODOO_URL (default: loopback and the compose name "odoo")
ODOO_ALLOWED_HOSTS=
# Optional: days a coupon stays valid (default 7)
ODOO_COUPON_DAYS=

# Q12 privacy (#85). ERP mode is off unless set; every ERP value must be set explicitly.
# SCAN_MODE=synthetic|erp (default synthetic). PROPOSAL_ERP_MODE / EXECUTION_ERP_MODE=YES enable ERP runs.
SCAN_MODE=
PROPOSAL_ERP_MODE=
EXECUTION_ERP_MODE=
PRIVACY_RETENTION_DAYS=
# Secret, at least 32 characters; used for HMAC-SHA256 tombstones and destination hashes.
PRIVACY_TOMBSTONE_PEPPER=
CAMPAIGN_COOLDOWN_DAYS=
ERP_SCAN_CHANNEL=
# Exact-match outbound allowlists (comma separated); empty blocks every recipient.
EXECUTION_ALLOWLIST_DOMAINS=
EXECUTION_ALLOWLIST_EMAILS=
TELEGRAM_ALLOWLIST_CHAT_IDS=

# AI engine database (separate from Odoo)
ENGINE_DB_PASSWORD=
ENGINE_DB_HOST_PORT=5433
# Example: postgresql://engine:<ENGINE_DB_PASSWORD>@127.0.0.1:5433/engine
ENGINE_DATABASE_URL=

# Local synthetic approval API (generate a unique token; never commit it)
# #86 OIDC/JWKS operator auth. Local dev: python -m scripts.dev_oidc init --dir .local/dev-oidc,
# then OIDC_JWKS_FILE=<dir>/jwks.json (FULL_STACK_OIDC_DIR for Compose). Cloud: OIDC_JWKS_URL (https).
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Claim holding viewer/approver/admin (Cognito: verify the group claim name on a real token).
OIDC_ROLES_CLAIM=
OIDC_JWKS_FILE=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
FULL_STACK_OIDC_DIR=
# Cloud only: shared secret CloudFront adds as X-Origin-Verify (32+ chars). Unset for local dev.
APPROVAL_ORIGIN_VERIFY_SECRET=
# Approval lifetime in hours (1-168, default 24).
APPROVAL_TTL_HOURS=
# Operator CLI / live E2E bearer token (env only, never an argument).
APPROVAL_ACCESS_TOKEN=
APPROVAL_API_PORT=8080

# LLM providers (see docs/adr/0003)
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8025

# Observability (free tiers, see docs/adr/0007)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_TOKEN=
