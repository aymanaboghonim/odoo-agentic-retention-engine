// Grafana Alloy: host and PostgreSQL metrics only (ADR-0033, OBS-14, OBS-22). No logs, no Docker
// socket, no host root.
// The container mounts the host /proc and /sys read-only at /host/proc and /host/sys. The root
// filesystem is read through the container's own overlay root, which reports the host volume.
// Environment: GRAFANA_OTLP_ENDPOINT, GRAFANA_OTLP_TOKEN (base64 of <instance-id>:<token>, the
// same SSM value the engine uses), TELEMETRY_ENVIRONMENT, and the passwords of the monitoring
// role aorte_monitor (#166: LOGIN and CONNECT only, no pg_monitor): ENGINE_MONITOR_PASSWORD,
// ODOO_MONITOR_PASSWORD.
// tests/test_alloy_config.py checks the allowlist below; change both together.

prometheus.exporter.unix "host" {
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  set_collectors = ["cpu", "meminfo", "loadavg", "filesystem"]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  job_name        = "aorte-alloy"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.allowlist.receiver]
}

prometheus.relabel "allowlist" {
  // Metric names: everything else (including scrape_* and up) is dropped.
  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_seconds_total|node_memory_MemTotal_bytes|node_memory_MemAvailable_bytes|node_load1|node_load5|node_filesystem_size_bytes|node_filesystem_avail_bytes"
    action        = "keep"
  }
  // CPU: only the modes the dashboard uses.
  rule {
    source_labels = ["__name__", "mode"]
    regex         = "node_cpu_seconds_total;(nice|irq|softirq)"
    action        = "drop"
  }
  // Filesystem: the root volume only.
  rule {
    source_labels = ["__name__", "mountpoint"]
    regex         = "node_filesystem_.+;(?:/.+|)"
    action        = "drop"
  }
  // Closed label set: drop the labels the panels do not need.
  rule {
    regex  = "device|fstype"
    action = "labeldrop"
  }
  forward_to = [otelcol.receiver.prometheus.host.receiver]
}

// PostgreSQL (#166): one component per server, because enabled_collectors applies only to the
// first data source of a component (F-100). No stat_statements, so no query text.
prometheus.exporter.postgres "engine" {
  data_source_names        = ["postgresql://aorte_monitor:" + sys.env("ENGINE_MONITOR_PASSWORD") + "@engine-db:5432/engine?sslmode=disable"]
  enabled_collectors       = ["database", "stat_database"]
  disable_settings_metrics = true
}

prometheus.exporter.postgres "odoo" {
  data_source_names        = ["postgresql://aorte_monitor:" + sys.env("ODOO_MONITOR_PASSWORD") + "@odoo-db:5432/odoo?sslmode=disable"]
  enabled_collectors       = ["database", "stat_database"]
  disable_settings_metrics = true
}

prometheus.scrape "postgres" {
  targets         = array.concat(prometheus.exporter.postgres.engine.targets, prometheus.exporter.postgres.odoo.targets)
  job_name        = "aorte-alloy"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.postgres.receiver]
}

prometheus.relabel "postgres" {
  rule {
    source_labels = ["__name__"]
    regex         = "pg_up|pg_database_size_bytes|pg_stat_database_numbackends"
    action        = "keep"
  }
  // Only the application database of each server (not postgres or the templates).
  rule {
    source_labels = ["__name__", "datname"]
    regex         = "pg_(database_size_bytes|stat_database_numbackends);(?:engine|odoo)"
    target_label  = "__tmp_keep"
    replacement   = "yes"
  }
  rule {
    source_labels = ["__name__", "__tmp_keep"]
    regex         = "pg_(database_size_bytes|stat_database_numbackends);"
    action        = "drop"
  }
  // The server name from the credential-free instance label (postgresql://<host>:<port>/<db>).
  rule {
    source_labels = ["instance"]
    regex         = "postgresql://(engine-db|odoo-db):5432/.*"
    target_label  = "aorte_server"
    replacement   = "$1"
  }
  rule {
    regex  = "datid|datname|server|__tmp_keep"
    action = "labeldrop"
  }
  forward_to = [otelcol.receiver.prometheus.host.receiver]
}

otelcol.receiver.prometheus "host" {
  output {
    metrics = [otelcol.processor.transform.resource.input]
  }
}

// Same resource keys as the engine, so the dashboard filters work unchanged.
otelcol.processor.transform "resource" {
  error_mode = "ignore"
  metric_statements {
    context    = "resource"
    statements = [
      `set(attributes["deployment.environment.name"], "` + sys.env("TELEMETRY_ENVIRONMENT") + `")`,
      `set(attributes["service.name"], "aorte-alloy")`,
      // The receiver adds scrape details (the container host name changes on each start).
      `keep_keys(attributes, ["deployment.environment.name", "service.name"])`,
    ]
  }
  output {
    metrics = [otelcol.processor.batch.out.input]
  }
}

otelcol.processor.batch "out" {
  output {
    metrics = [otelcol.exporter.otlphttp.grafana.input]
  }
}

otelcol.exporter.otlphttp "grafana" {
  client {
    endpoint = sys.env("GRAFANA_OTLP_ENDPOINT")
    headers  = {
      "Authorization" = "Basic " + sys.env("GRAFANA_OTLP_TOKEN"),
    }
  }
}
