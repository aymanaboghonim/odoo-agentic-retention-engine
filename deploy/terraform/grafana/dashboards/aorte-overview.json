{
  "uid": "aorte-overview",
  "title": "aorte engine overview",
  "description": "Managed by Terraform (deploy/terraform/grafana, #139). Edits in the UI are overwritten.",
  "tags": [
    "aorte",
    "terraform"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "hide": 0
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "aws-mvp,local,eval",
        "current": {
          "text": "aws-mvp",
          "value": "aws-mvp"
        },
        "options": [
          {
            "text": "aws-mvp",
            "value": "aws-mvp",
            "selected": true
          },
          {
            "text": "local",
            "value": "local",
            "selected": false
          },
          {
            "text": "eval",
            "value": "eval",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Runs and worker health",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Runs by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum by (aorte_state) (aorte_runs{deployment_environment_name=\"$env\"})",
          "legendFormat": "{{aorte_state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Held effects (unknown outcome)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "max(aorte_execution_held{deployment_environment_name=\"$env\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Worker last scan age",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "max(aorte_worker_last_scan_age_seconds{deployment_environment_name=\"$env\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 180
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Runtime state",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "1 for the current state; unreadable counts as halted (KS-6).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "max by (aorte_runtime_state) (aorte_runtime_state_ratio{deployment_environment_name=\"$env\"}) == 1",
          "legendFormat": "{{aorte_runtime_state}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Worker last scan age",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "max(aorte_worker_last_scan_age_seconds{deployment_environment_name=\"$env\"})",
          "legendFormat": "age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 4
      }
    },
    {
      "type": "row",
      "title": "LLM cost and run traces",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "LLM tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum by (gen_ai_token_type) (increase({__name__=~\"aorte_llm_tokens.*_total\", deployment_environment_name=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Estimated LLM USD (time range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "Settled ledger estimate (OBS-9), not a bill.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum(increase({__name__=~\"aorte_llm_cost_usd.*_total\", deployment_environment_name=\"$env\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 4,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Run traces: LLM calls (click a row to open it in Langfuse)",
      "description": "One run is one trace in Tempo and Langfuse (OBS-17). Links use the full trace ID (aorte.trace_id).",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"aorte.llm.call\" && resource.deployment.environment.name = \"$env\" } | select(span.gen_ai.request.model, span.gen_ai.usage.input_tokens, span.gen_ai.usage.output_tokens, span.gen_ai.usage.cost, span.aorte.trace_id)",
          "tableType": "spans",
          "limit": 50
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open this trace in Langfuse",
              "targetBlank": true,
              "url": "__LANGFUSE_TRACE_BASE__${__data.fields[\"aorte.trace_id\"]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Gate decisions",
      "description": "Gate outcome per run; the link opens the run trace in Langfuse.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"aorte.gate\" && resource.deployment.environment.name = \"$env\" } | select(span.aorte.gate.outcome, span.aorte.trace_id)",
          "tableType": "spans",
          "limit": 50
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open this trace in Langfuse",
              "targetBlank": true,
              "url": "__LANGFUSE_TRACE_BASE__${__data.fields[\"aorte.trace_id\"]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "Export checks (telemetry_check, SM-6)",
      "description": "Live export checks; the same trace is in Langfuse when the check sent to both.",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"aorte.check\" } | select(span.aorte.trace_id)",
          "tableType": "spans",
          "limit": 50
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open this trace in Langfuse",
              "targetBlank": true,
              "url": "__LANGFUSE_TRACE_BASE__${__data.fields[\"aorte.trace_id\"]}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "row",
      "title": "Effects and telemetry",
      "collapsed": false,
      "panels": [],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Effect outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum by (aorte_effect, aorte_outcome) (increase({__name__=~\"aorte_execution_effects.*_total\", deployment_environment_name=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{aorte_effect}} {{aorte_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Dropped telemetry",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "description": "daily_cap means the export cap was reached (OBS-13).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum by (aorte_signal, aorte_reason) (increase({__name__=~\"aorte_telemetry_dropped.*_total\", deployment_environment_name=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{aorte_signal}} {{aorte_reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 15,
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      }
    }
  ]
}
